# ==============================================================================
# Tata Technologies: Rule-Verified AI Assistant for UDS Diagnostics
# Environment Configuration Template (.env.example)
#
# INSTRUCTIONS:
# Copy this file to .env and adjust variables for your local deployment.
# Never commit the actual .env file with real secrets into version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SECURITY & ADMINISTRATOR AUTHENTICATION
# ------------------------------------------------------------------------------
# [REQUIRED for Admin Endpoints / UI Activity Dashboard]
# Cryptographic access key required to view security telemetry, query logs,
# and system audit reports. Must be set to a secure secret in production/pilot.
UDS_ADMIN_KEY=CHANGE_ME_TO_A_RANDOM_SECRET

# ------------------------------------------------------------------------------
# 2. REST API SERVICE CONFIGURATION
# ------------------------------------------------------------------------------
# [OPTIONAL] Host interface to bind FastAPI backend (Default: 0.0.0.0 in Docker, 127.0.0.1 local)
UDS_API_HOST=0.0.0.0

# [OPTIONAL] Port for FastAPI backend (Default: 8000)
UDS_API_PORT=8000

# [OPTIONAL] Base URL used by clients/web frontend to communicate with API
UDS_API_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# 3. STREAMLIT WEB UI CONFIGURATION
# ------------------------------------------------------------------------------
# [OPTIONAL] Port for Streamlit engineering platform UI (Default: 8501)
UDS_STREAMLIT_PORT=8501

# ------------------------------------------------------------------------------
# 4. LLM & RUNTIME SERVICE INTEGRATION (AD-01)
# ------------------------------------------------------------------------------
# [OPTIONAL] Ollama host endpoint for local Llama 3.1 8B / Qwen 2.5 7B runtime
# When running inside Docker, point to: http://host.docker.internal:11434
# When running locally on host machine: http://localhost:11434
OLLAMA_HOST=http://localhost:11434

# ------------------------------------------------------------------------------
# 5. PRIVACY & TELEMETRY CONFIGURATION
# ------------------------------------------------------------------------------
# [OPTIONAL] Whether to log client IP addresses (Default: false)
UDS_LOG_CLIENT_IP=false

# [OPTIONAL] Whether to mask IPv4 addresses to /24 (Default: true)
UDS_ANONYMIZE_IP=true
